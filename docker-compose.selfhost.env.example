# Copy to .env next to docker-compose.selfhost.yml (`cp docker-compose.selfhost.env.example .env`).
# .env is gitignored. Compose reads it automatically.

# Required. Choose your own; letters and digits only, because it goes into the
# connection URL. Set it before the first `up`: Postgres applies it only when it
# creates the data directory, so a later change does not reach an existing volume.
GBRAIN_SELFHOST_PG_PASSWORD=

# Optional. Host port on 127.0.0.1 (default 5438). 5434-5437 belong to the
# init ladder container and the CI/E2E compose files.
# GBRAIN_SELFHOST_PG_PORT=5438
