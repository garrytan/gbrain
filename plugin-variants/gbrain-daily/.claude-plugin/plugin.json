{
  "name": "gbrain-daily",
  "version": "0.57.0.12",
  "description": "Personal knowledge-brain daily use: meetings, tasks, briefings, reading, research. Published as the gbrain-daily marketplace variant. (persona variant of the gbrain plugin — 20 skills)",
  "author": {
    "name": "Garry Tan",
    "url": "https://github.com/garrytan"
  },
  "homepage": "https://github.com/garrytan/gbrain",
  "repository": "https://github.com/garrytan/gbrain",
  "license": "MIT",
  "keywords": [
    "memory",
    "knowledge-base",
    "mcp",
    "search",
    "agent",
    "brain",
    "pgvector"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "gbrain": {
      "command": "${CLAUDE_PLUGIN_ROOT}/.agents/gbrain-launcher",
      "args": [
        "serve",
        "--surface",
        "starter",
        "--source-guard"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
