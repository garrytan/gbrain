{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/contradiction.schema.json",
  "title": "CoE Lite v1 contradiction",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "contradiction_id": {
      "$ref": "#/$defs/__schema1"
    },
    "left_claim_id": {
      "$ref": "#/$defs/__schema2"
    },
    "right_claim_id": {
      "$ref": "#/$defs/__schema3"
    },
    "status": {
      "$ref": "#/$defs/__schema4"
    },
    "resolution": {
      "$ref": "#/$defs/__schema5"
    },
    "verification_run_ids": {
      "$ref": "#/$defs/__schema6"
    },
    "resolution_note": {
      "$ref": "#/$defs/__schema7"
    },
    "scope": {
      "$ref": "#/$defs/__schema9"
    },
    "created_at": {
      "$ref": "#/$defs/__schema14"
    },
    "updated_at": {
      "$ref": "#/$defs/__schema14"
    }
  },
  "required": [
    "schema_version",
    "contradiction_id",
    "left_claim_id",
    "right_claim_id",
    "status",
    "resolution",
    "verification_run_ids",
    "scope",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^ctr_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{64}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "open",
        "confirmed",
        "resolved",
        "dismissed"
      ]
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "unresolved",
        "supersedes",
        "coexists",
        "source_error",
        "claim_error"
      ]
    },
    "__schema6": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^vrf_[0-9a-f]{64}$"
      }
    },
    "__schema7": {
      "$ref": "#/$defs/__schema8"
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema8"
        },
        "visibility": {
          "$ref": "#/$defs/__schema10"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema8"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema11"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema12"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema11": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema12": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema13"
      }
    },
    "__schema13": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema14": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
