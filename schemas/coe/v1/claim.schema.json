{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/claim.schema.json",
  "title": "CoE Lite v1 claim",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "claim_id": {
      "$ref": "#/$defs/__schema1"
    },
    "claim_type": {
      "$ref": "#/$defs/__schema2"
    },
    "origin": {
      "$ref": "#/$defs/__schema3"
    },
    "subject": {
      "$ref": "#/$defs/__schema4"
    },
    "predicate": {
      "$ref": "#/$defs/__schema4"
    },
    "value": {
      "$ref": "#/$defs/__schema5"
    },
    "statement": {
      "$ref": "#/$defs/__schema4"
    },
    "status": {
      "$ref": "#/$defs/__schema7"
    },
    "supersedes_claim_id": {
      "$ref": "#/$defs/__schema8"
    },
    "retraction_reason": {
      "$ref": "#/$defs/__schema9"
    },
    "scope": {
      "$ref": "#/$defs/__schema10"
    },
    "created_at": {
      "$ref": "#/$defs/__schema15"
    },
    "updated_at": {
      "$ref": "#/$defs/__schema15"
    },
    "created_by": {
      "$ref": "#/$defs/__schema16"
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "claim_type",
    "origin",
    "subject",
    "predicate",
    "value",
    "statement",
    "status",
    "scope",
    "created_at",
    "updated_at",
    "created_by"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "bibliographic",
        "numeric",
        "methodological",
        "process",
        "descriptive",
        "conclusion",
        "recommendation",
        "inference",
        "contradiction",
        "software_artifact"
      ]
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "direct_source",
        "derived_inference",
        "derived_recommendation",
        "human_authored",
        "system_generated",
        "imported_legacy"
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)$"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "decimal"
            },
            "value": {
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "quantity"
            },
            "value": {
              "$ref": "#/$defs/__schema6"
            },
            "unit": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "required": [
            "kind",
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema6": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "draft",
        "quarantined",
        "verified",
        "partially_supported",
        "contradicted",
        "rejected",
        "superseded",
        "retracted",
        "needs_review"
      ]
    },
    "__schema8": {
      "type": "string",
      "pattern": "^clm_[0-9a-f]{64}$"
    },
    "__schema9": {
      "$ref": "#/$defs/__schema4"
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema4"
        },
        "visibility": {
          "$ref": "#/$defs/__schema11"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema4"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema12"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema12": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema13": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      }
    },
    "__schema14": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema15": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "system",
            "llm"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "additionalProperties": false
    }
  }
}
