{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/source_snapshot.schema.json",
  "title": "CoE Lite v1 source_snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "snapshot_id": {
      "$ref": "#/$defs/__schema1"
    },
    "source_id": {
      "$ref": "#/$defs/__schema2"
    },
    "acquired_at": {
      "$ref": "#/$defs/__schema3"
    },
    "acquisition_method": {
      "$ref": "#/$defs/__schema4"
    },
    "content_hash": {
      "$ref": "#/$defs/__schema5"
    },
    "byte_size": {
      "$ref": "#/$defs/__schema6"
    },
    "media_type": {
      "$ref": "#/$defs/__schema7"
    },
    "object_key": {
      "$ref": "#/$defs/__schema8"
    },
    "status": {
      "$ref": "#/$defs/__schema9"
    },
    "supersedes_snapshot_id": {
      "$ref": "#/$defs/__schema10"
    },
    "retraction_reason": {
      "$ref": "#/$defs/__schema11"
    },
    "scope": {
      "$ref": "#/$defs/__schema12"
    },
    "created_by": {
      "$ref": "#/$defs/__schema17"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "source_id",
    "acquired_at",
    "acquisition_method",
    "content_hash",
    "byte_size",
    "media_type",
    "object_key",
    "status",
    "scope",
    "created_by"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema3": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "upload",
        "http",
        "filesystem",
        "api",
        "legacy_import"
      ]
    },
    "__schema5": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema6": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema7": {
      "type": "string",
      "minLength": 1
    },
    "__schema8": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema9": {
      "type": "string",
      "enum": [
        "active",
        "quarantined",
        "superseded",
        "retracted"
      ]
    },
    "__schema10": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "__schema11": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema7"
        },
        "visibility": {
          "$ref": "#/$defs/__schema13"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema7"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema14"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema15"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema14": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema15": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema16"
      }
    },
    "__schema16": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "system",
            "llm"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "additionalProperties": false
    }
  }
}
