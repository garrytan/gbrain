{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/evidence_item.schema.json",
  "title": "CoE Lite v1 evidence_item",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "evidence_id": {
      "$ref": "#/$defs/__schema1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/__schema2"
    },
    "normalized_document_id": {
      "$ref": "#/$defs/__schema3"
    },
    "section_id": {
      "$ref": "#/$defs/__schema4"
    },
    "evidence_type": {
      "$ref": "#/$defs/__schema5"
    },
    "normalized_text": {
      "$ref": "#/$defs/__schema4"
    },
    "text_hash": {
      "$ref": "#/$defs/__schema6"
    },
    "normalized_span": {
      "$ref": "#/$defs/__schema7"
    },
    "raw_locator": {
      "$ref": "#/$defs/__schema10"
    },
    "status": {
      "$ref": "#/$defs/__schema18"
    },
    "supersedes_evidence_id": {
      "$ref": "#/$defs/__schema19"
    },
    "retraction_reason": {
      "$ref": "#/$defs/__schema20"
    },
    "scope": {
      "$ref": "#/$defs/__schema21"
    },
    "created_at": {
      "$ref": "#/$defs/__schema26"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "snapshot_id",
    "normalized_document_id",
    "section_id",
    "evidence_type",
    "normalized_text",
    "text_hash",
    "normalized_span",
    "raw_locator",
    "status",
    "scope",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^evd_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^ndoc_[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "quote",
        "table_cell",
        "figure",
        "code_block",
        "metadata"
      ]
    },
    "__schema6": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/__schema8"
        },
        "end": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema9": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema10": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema11"
        },
        {
          "$ref": "#/$defs/__schema12"
        },
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "$ref": "#/$defs/__schema14"
        },
        {
          "$ref": "#/$defs/__schema15"
        },
        {
          "$ref": "#/$defs/__schema16"
        },
        {
          "$ref": "#/$defs/__schema17"
        }
      ]
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pdf_page"
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "bounding_box": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "page"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "line_range"
        },
        "start_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "end_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "html_selector"
        },
        "selector": {
          "$ref": "#/$defs/__schema4"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "selector",
        "occurrence"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "byte_range"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_byte": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "start_byte",
        "end_byte"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "block"
        },
        "block_id": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "kind",
        "block_id"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "table_cell"
        },
        "table_id": {
          "$ref": "#/$defs/__schema4"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "table_id",
        "row",
        "column"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "code_range"
        },
        "path": {
          "$ref": "#/$defs/__schema4"
        },
        "start_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "end_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "path",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "string",
      "enum": [
        "active",
        "quarantined",
        "superseded",
        "retracted"
      ]
    },
    "__schema19": {
      "type": "string",
      "pattern": "^evd_[0-9a-f]{64}$"
    },
    "__schema20": {
      "$ref": "#/$defs/__schema4"
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema4"
        },
        "visibility": {
          "$ref": "#/$defs/__schema22"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema4"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema23"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema24"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema23": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema24": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema25"
      }
    },
    "__schema25": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema26": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
