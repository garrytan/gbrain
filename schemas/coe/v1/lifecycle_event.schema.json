{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/lifecycle_event.schema.json",
  "title": "CoE Lite v1 lifecycle_event",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "event_id": {
      "$ref": "#/$defs/__schema1"
    },
    "aggregate_type": {
      "$ref": "#/$defs/__schema2"
    },
    "aggregate_id": {
      "$ref": "#/$defs/__schema3"
    },
    "event_type": {
      "$ref": "#/$defs/__schema4"
    },
    "from_status": {
      "$ref": "#/$defs/__schema5"
    },
    "to_status": {
      "$ref": "#/$defs/__schema7"
    },
    "reason_code": {
      "$ref": "#/$defs/__schema6"
    },
    "payload_hash": {
      "$ref": "#/$defs/__schema8"
    },
    "actor": {
      "$ref": "#/$defs/__schema9"
    },
    "scope": {
      "$ref": "#/$defs/__schema10"
    },
    "occurred_at": {
      "$ref": "#/$defs/__schema15"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "aggregate_type",
    "aggregate_id",
    "event_type",
    "reason_code",
    "payload_hash",
    "actor",
    "scope",
    "occurred_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "claim",
        "snapshot",
        "evidence",
        "verification",
        "retrieval",
        "answer",
        "contradiction"
      ]
    },
    "__schema3": {
      "type": "string",
      "pattern": "^(?:src|snp|ndoc|evd|clm|cedge|vrf|ret|ans|acm|ctr|evt|pol)_[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "created",
        "status_changed",
        "verification_recorded",
        "scope_changed",
        "invalidated",
        "released"
      ]
    },
    "__schema5": {
      "$ref": "#/$defs/__schema6"
    },
    "__schema6": {
      "type": "string",
      "minLength": 1
    },
    "__schema7": {
      "$ref": "#/$defs/__schema6"
    },
    "__schema8": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "system",
            "llm"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema6"
        },
        "visibility": {
          "$ref": "#/$defs/__schema11"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema6"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema12"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema12": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema13": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      }
    },
    "__schema14": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema15": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
