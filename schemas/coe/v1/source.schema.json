{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/source.schema.json",
  "title": "CoE Lite v1 source",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "source_id": {
      "$ref": "#/$defs/__schema1"
    },
    "source_kind": {
      "$ref": "#/$defs/__schema2"
    },
    "title": {
      "$ref": "#/$defs/__schema3"
    },
    "canonical_uri": {
      "$ref": "#/$defs/__schema4"
    },
    "authors": {
      "$ref": "#/$defs/__schema5"
    },
    "publisher": {
      "$ref": "#/$defs/__schema6"
    },
    "published_at": {
      "$ref": "#/$defs/__schema7"
    },
    "language": {
      "$ref": "#/$defs/__schema8"
    },
    "license": {
      "$ref": "#/$defs/__schema9"
    },
    "external_identifiers": {
      "$ref": "#/$defs/__schema10"
    },
    "scope": {
      "$ref": "#/$defs/__schema11"
    },
    "created_at": {
      "$ref": "#/$defs/__schema16"
    },
    "created_by": {
      "$ref": "#/$defs/__schema17"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_kind",
    "title",
    "authors",
    "language",
    "external_identifiers",
    "scope",
    "created_at",
    "created_by"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "paper",
        "book",
        "web_page",
        "dataset",
        "code",
        "note",
        "report",
        "media"
      ]
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "__schema4": {
      "type": "string",
      "format": "uri"
    },
    "__schema5": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "display_name": {
            "$ref": "#/$defs/__schema3"
          },
          "identifier": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "required": [
          "display_name"
        ],
        "additionalProperties": false
      }
    },
    "__schema6": {
      "$ref": "#/$defs/__schema3"
    },
    "__schema7": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "__schema8": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "__schema9": {
      "$ref": "#/$defs/__schema3"
    },
    "__schema10": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scheme": {
            "type": "string",
            "enum": [
              "doi",
              "isbn",
              "pmid",
              "arxiv",
              "url",
              "custom"
            ]
          },
          "value": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "required": [
          "scheme",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema3"
        },
        "visibility": {
          "$ref": "#/$defs/__schema12"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema3"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema13"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema13": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "__schema14": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema15"
      }
    },
    "__schema15": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema16": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "system",
            "llm"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "additionalProperties": false
    }
  }
}
