{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/normalized_document.schema.json",
  "title": "CoE Lite v1 normalized_document",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "normalized_document_id": {
      "$ref": "#/$defs/__schema1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/__schema2"
    },
    "content_hash": {
      "$ref": "#/$defs/__schema3"
    },
    "byte_size": {
      "$ref": "#/$defs/__schema4"
    },
    "object_key": {
      "$ref": "#/$defs/__schema5"
    },
    "normalizer": {
      "$ref": "#/$defs/__schema6"
    },
    "sections": {
      "$ref": "#/$defs/__schema8"
    },
    "mappings": {
      "$ref": "#/$defs/__schema12"
    },
    "warnings": {
      "$ref": "#/$defs/__schema24"
    },
    "scope": {
      "$ref": "#/$defs/__schema25"
    },
    "created_at": {
      "$ref": "#/$defs/__schema30"
    }
  },
  "required": [
    "schema_version",
    "normalized_document_id",
    "snapshot_id",
    "content_hash",
    "byte_size",
    "object_key",
    "normalizer",
    "sections",
    "mappings",
    "warnings",
    "scope",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^ndoc_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^snp_[0-9a-f]{64}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/__schema7"
        },
        "version": {
          "$ref": "#/$defs/__schema7"
        },
        "config_hash": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "name",
        "version",
        "config_hash"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "minLength": 1
    },
    "__schema8": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "section_id": {
          "$ref": "#/$defs/__schema7"
        },
        "parent_section_id": {
          "$ref": "#/$defs/__schema7"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "$ref": "#/$defs/__schema7"
        },
        "normalized_span": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "#/$defs/__schema10"
            },
            "end": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "text_hash": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "section_id",
        "ordinal",
        "level",
        "normalized_span",
        "text_hash"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema11": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema12": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema13"
      }
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "section_id": {
          "$ref": "#/$defs/__schema7"
        },
        "normalized_start": {
          "$ref": "#/$defs/__schema14"
        },
        "normalized_end": {
          "$ref": "#/$defs/__schema15"
        },
        "raw_locator": {
          "$ref": "#/$defs/__schema16"
        }
      },
      "required": [
        "section_id",
        "normalized_start",
        "normalized_end",
        "raw_locator"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema15": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema16": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema17"
        },
        {
          "$ref": "#/$defs/__schema18"
        },
        {
          "$ref": "#/$defs/__schema19"
        },
        {
          "$ref": "#/$defs/__schema20"
        },
        {
          "$ref": "#/$defs/__schema21"
        },
        {
          "$ref": "#/$defs/__schema22"
        },
        {
          "$ref": "#/$defs/__schema23"
        }
      ]
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pdf_page"
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "bounding_box": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "page"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "line_range"
        },
        "start_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "end_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "html_selector"
        },
        "selector": {
          "$ref": "#/$defs/__schema7"
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "selector",
        "occurrence"
      ],
      "additionalProperties": false
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "byte_range"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_byte": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "start_byte",
        "end_byte"
      ],
      "additionalProperties": false
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "block"
        },
        "block_id": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "kind",
        "block_id"
      ],
      "additionalProperties": false
    },
    "__schema22": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "table_cell"
        },
        "table_id": {
          "$ref": "#/$defs/__schema7"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "table_id",
        "row",
        "column"
      ],
      "additionalProperties": false
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "code_range"
        },
        "path": {
          "$ref": "#/$defs/__schema7"
        },
        "start_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "end_line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "path",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "__schema24": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/$defs/__schema7"
          },
          "message": {
            "$ref": "#/$defs/__schema7"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "blocking"
            ]
          },
          "locator": {
            "$ref": "#/$defs/__schema16"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ],
        "additionalProperties": false
      }
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema7"
        },
        "visibility": {
          "$ref": "#/$defs/__schema26"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema7"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema27"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema28"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema26": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema27": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema28": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema29"
      }
    },
    "__schema29": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    },
    "__schema30": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
