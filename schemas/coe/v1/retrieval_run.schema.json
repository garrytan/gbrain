{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbrain.example/schemas/coe/v1/retrieval_run.schema.json",
  "title": "CoE Lite v1 retrieval_run",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "retrieval_run_id": {
      "$ref": "#/$defs/__schema1"
    },
    "query_hash": {
      "$ref": "#/$defs/__schema2"
    },
    "policy_id": {
      "$ref": "#/$defs/__schema3"
    },
    "policy_version": {
      "$ref": "#/$defs/__schema4"
    },
    "filters": {
      "$ref": "#/$defs/__schema5"
    },
    "candidates": {
      "$ref": "#/$defs/__schema7"
    },
    "selected_evidence_ids": {
      "$ref": "#/$defs/__schema9"
    },
    "request_scope": {
      "$ref": "#/$defs/__schema10"
    },
    "started_at": {
      "$ref": "#/$defs/__schema6"
    },
    "finished_at": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "schema_version",
    "retrieval_run_id",
    "query_hash",
    "policy_id",
    "policy_version",
    "filters",
    "candidates",
    "selected_evidence_ids",
    "request_scope",
    "started_at",
    "finished_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^ret_[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^pol_[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "brain_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src_[0-9a-f]{64}$"
          }
        },
        "claim_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bibliographic",
              "numeric",
              "methodological",
              "process",
              "descriptive",
              "conclusion",
              "recommendation",
              "inference",
              "contradiction",
              "software_artifact"
            ]
          }
        },
        "snapshot_statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "active",
              "quarantined",
              "superseded",
              "retracted"
            ]
          }
        },
        "as_of": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "brain_ids",
        "source_ids",
        "claim_types",
        "snapshot_statuses"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^evd_[0-9a-f]{64}$"
          },
          "rank": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "lexical_score": {
            "$ref": "#/$defs/__schema8"
          },
          "semantic_score": {
            "$ref": "#/$defs/__schema8"
          },
          "rerank_score": {
            "$ref": "#/$defs/__schema8"
          },
          "selected": {
            "type": "boolean"
          },
          "exclusion_reason": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "required": [
          "evidence_id",
          "rank",
          "selected"
        ],
        "additionalProperties": false
      }
    },
    "__schema8": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "__schema9": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evd_[0-9a-f]{64}$"
      }
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "brain_id": {
          "$ref": "#/$defs/__schema4"
        },
        "visibility": {
          "$ref": "#/$defs/__schema11"
        },
        "owner_principal": {
          "$ref": "#/$defs/__schema4"
        },
        "reader_principals": {
          "$ref": "#/$defs/__schema12"
        },
        "source_ids": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "brain_id",
        "visibility",
        "owner_principal",
        "reader_principals",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "private",
        "workspace",
        "public"
      ]
    },
    "__schema12": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema13": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      }
    },
    "__schema14": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{64}$"
    }
  }
}
