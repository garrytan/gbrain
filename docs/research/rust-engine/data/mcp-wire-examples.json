   "code": "trusted_local_only",
   "message": "purge_fact runs only from the trusted local CLI on the brain host, not over MCP.",
   "suggestion": "Ask the user to run `gbrain forget <id> --purge` on the brain host. Next: gbrain forget '<id>' --purge",
   "docs": "https://github.com/garrytan/gbrain/blob/master/docs/guides/error-codes.md#trusted_local_only",
   "fix": {
    "argv": [
     "gbrain",
     "forget",
     "<id>",
     "--purge"
    ],
    "command": "gbrain forget '<id>' --purge",
    "consent": [],
    "actor": "user",
    "next": "tell_user_to_run",
    "why": "purge_fact is owner-only (filesystem, credentials or review authority), so no MCP connection can call it.",
    "requires_exclusive": false,
    "inputs": [
