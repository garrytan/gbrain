[
  {
    "name": "remember",
    "description": "Save {fact, provenance (required), `entity` (subject; recall needs it)} or items[]. Branch on `status`; write_pending: poll get_write_request.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "description": "Write source."
        },
        "request_id": {
          "type": "string",
          "description": "Reuse only to retry."
        },
        "fact": {
          "type": "string",
          "description": "One claim."
        },
        "items": {
          "type": "array",
          "description": "≤20 of {fact,entity,provenance,kind,ttl,visibility}",
          "items": {
            "type": "object"
          }
        },
        "provenance": {
          "type": "string",
          "description": "Source (≤500 chars)."
        },
        "ttl": {
          "type": "string",
          "description": "\"30d\", \"12h\", ISO; omit = never."
        },
        "entity": {
          "type": "string",
          "description": "Name or slug."
        },
        "kind": {
          "type": "string",
          "description": "Default fact.",
          "enum": [
            "event",
            "preference",
            "commitment",
            "belief",
            "fact"
          ]
        },
        "share": {
          "type": "boolean",
          "description": "Members save privately, owner shared; true: all source readers recall it. Not for facts about a person."
        }
      },
      "required": []
    },
    "annotations": {
      "title": "remember (memory write)",
      "idempotentHint": true
    }
  },
