{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-resolver.v1.turn-output.json",
  "title": "gbrain skill resolver: turn output (schema_version 1)",
  "description": "The result of one turn (`gbrain skills resolve --json`, resolveSkills().output). Everything outside `meta` is byte-identical for the same index, input and session state, except on a turn the model picker answered or was asked (router), or a turn whose catalog has skill vectors (vectors). Within v1, changes are additive only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gbrain_version",
    "catalog",
    "catalog_hash",
    "index_hash",
    "ranker",
    "no_skill",
    "no_skill_reason",
    "budget_exhausted",
    "suggestions",
    "block",
    "block_tokens",
    "tokenizer",
    "deduped",
    "shadow",
    "meta"
  ],
  "$defs": {
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestion"
      ],
      "properties": {
        "suggestion": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "score",
        "summary",
        "reason",
        "match_strength",
        "catalog"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The harness's exact load selector (for example plugin:skill)."
        },
        "name": {
          "type": "string",
          "description": "Display name."
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "maxLength": 121,
          "description": "The description cut at 120 characters; empty for names-only catalogs."
        },
        "reason": {
          "type": "string",
          "description": "The matched fields and terms."
        },
        "match_strength": {
          "enum": [
            "named",
            "picked",
            "name",
            "triggers",
            "routing",
            "description",
            "vector",
            "body"
          ],
          "description": "The strongest way it matched: named in the turn, picked by the model picker (skills.resolver.router), else the first matched field of name, triggers, routing, description, then vector (it matched on meaning alone: its cosine to the message is at or above the cosine floor), then body. An adapter that wants a floor drops body-only (or description-only) suggestions."
        },
        "path": {
          "type": "string",
          "description": "The SKILL.md path, when the catalog knows it."
        },
        "catalog": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "fix"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^skill_[a-z_]+$"
        },
        "message": {
          "type": "string"
        },
        "fix": {
          "$ref": "#/$defs/fix"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gbrain_version": {
      "type": "string"
    },
    "catalog": {
      "type": [
        "string",
        "null"
      ],
      "description": "The catalog name, or names joined with + when merged."
    },
    "catalog_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "index_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "ranker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "variant",
        "k"
      ],
      "properties": {
        "id": {
          "const": "bm25f-a5"
        },
        "version": {
          "const": 1
        },
        "variant": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[DT](\\+[DT])*$"
        },
        "k": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "no_skill": {
      "type": "boolean",
      "description": "True only for an acknowledgement or when no indexed term matches."
    },
    "no_skill_reason": {
      "enum": [
        "ack",
        "no_match",
        null
      ]
    },
    "budget_exhausted": {
      "type": "boolean"
    },
    "block_reason": {
      "description": "Why the block is empty; null when it has a suggestion.",
      "enum": [
        "ack",
        "no_match",
        "filtered",
        "weak_top_match",
        "deduped",
        "paced",
        "budget_exhausted",
        "shadow",
        "error",
        null
      ]
    },
    "suggestions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/suggestion"
      }
    },
    "block": {
      "type": "string",
      "description": "The <relevant_skills> block, or \"\"."
    },
    "block_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 400
    },
    "tokenizer": {
      "const": "gbrain-estimate-tokens-v1"
    },
    "deduped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shadow": {
      "type": "boolean"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present only when the model picker was on for the turn (skills.resolver.router, and a caller allowed to start it: the command line or the Claude Code and Codex hook lanes). Says who answered, with which model, how long the turn waited for it in milliseconds, its estimated cost in USD, and why it fell back to the word matcher.",
      "required": [
        "mode",
        "answered_by",
        "model",
        "ms",
        "est_usd",
        "fallback"
      ],
      "properties": {
        "mode": {
          "const": "picker"
        },
        "answered_by": {
          "enum": [
            "picker",
            "words"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "est_usd": {
          "type": "number",
          "minimum": 0
        },
        "fallback": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "timeout",
                    "provider_error",
                    "missing_key",
                    "daily_cap",
                    "parse_failed",
                    "no_known_ids",
                    "config_invalid",
                    "no_pricing",
                    "ledger_unavailable"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when a catalog of the turn has skill vectors (its receipt lists them), except on an acknowledgement turn, which neither embeds nor ranks. used says whether the turn ranked with them; model is the brain's embedder (null when none is configured); ms is how long the turn waited for the message's vector; fallback says why the turn did without them (not_needed: the model picker answered first).",
      "required": [
        "used",
        "model",
        "ms",
        "fallback"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "fallback": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "no_embedder",
                    "embedding_disabled",
                    "unsupported_provider",
                    "missing_key",
                    "provider_error",
                    "timeout",
                    "bad_reply",
                    "not_this_harness",
                    "project_scope",
                    "too_many_skills",
                    "stale_vectors",
                    "not_needed",
                    "unmeasured_model"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "explain": {
      "type": "object",
      "description": "Present only with --explain-target under --json.",
      "additionalProperties": false,
      "required": [
        "target",
        "indexed",
        "catalog",
        "rank",
        "score",
        "fields",
        "excluded",
        "deduped",
        "in_block",
        "skip_reason",
        "session"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "indexed": {
          "type": "boolean"
        },
        "catalog": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "excluded": {
          "type": "boolean"
        },
        "deduped": {
          "type": "boolean"
        },
        "in_block": {
          "type": "boolean"
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "vector": {
          "type": "object",
          "description": "Present only when skill vectors ranked the turn: the target's cosine with the message and its catalog's floor; rank and score stay the word ranking's.",
          "additionalProperties": false,
          "required": [
            "cosine",
            "floor"
          ],
          "properties": {
            "cosine": {
              "type": "number"
            },
            "floor": {
              "type": "number"
            }
          }
        },
        "session": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "turn",
            "spent",
            "budget",
            "remaining"
          ],
          "properties": {
            "turn": {
              "type": "integer",
              "minimum": 0
            },
            "spent": {
              "type": "integer",
              "minimum": 0
            },
            "budget": {
              "type": "integer",
              "minimum": 0
            },
            "remaining": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timing_ms",
        "index_age_s",
        "index_stale"
      ],
      "description": "The volatile part.",
      "properties": {
        "timing_ms": {
          "type": "number",
          "minimum": 0
        },
        "index_age_s": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "index_stale": {
          "type": "boolean"
        }
      }
    }
  }
}
