  "guards": [
    {
      "id": "serial-manifest",
      "when": [
        "test/**/*.serial.test.ts",
        "scripts/serial-files.tsv",
        "scripts/run-serial-tests.sh"
      ],
      "command": "bun test test/scripts/serial-files.test.ts",
      "fix": "add the serial file's row to scripts/serial-files.tsv"
    },
    {
      "id": "cli-goldens",
      "when": [
        "src/cli.ts",
        "src/cli/**",
        "src/commands/**",
        "src/core/operations*.ts",
        "src/core/ops/**"
      ],
      "command": "bun test --timeout=60000 test/cli-goldens.test.ts test/cli-dispatch-phase.test.ts test/export-surface-golden.test.ts",
      "fix": "bun run regen:all, then justify each changed golden in the PR body"
    },
    {
      "id": "regen-check",
      "when": [
        "src/**",
        "skills/**",
        "templates/**",
        "plugin/**"
      ],
      "command": "bun scripts/regen-all.ts --check",
      "fix": "bun run regen:all and commit the regenerated files"
    },
    {
      "id": "migration-order",
      "when": [
        "src/core/schema-migrations/**"
      ],
      "command": "bun scripts/check-schema-migration-order.ts",
      "fix": "renumber the migration to the next free number on master"
    }
  ],
  "sealed": {
    "paths": [
      "eval/reports/**",
      "**/sealed-confirmation/**",
      "**/hard-sealed/**",
      "**/counted/**"
    ],
    "transcripts": [
      "**/results.jsonl",
      "**/results.jsonl.gz",
      "**/usage.jsonl.gz"
    ],
    "visibility": "public"
  },
  "remote_gate": "bash scripts/pregate-remote-gate.sh",
  "run_profiles": {
    "test": {
      "workflow": "test.yml",
      "events": ["workflow_dispatch", "push"],
      "jobs": ["full-suite"],
      "artifact": "full-suite-tree",
      "os": "Linux"
    },
    "e2e": {
      "workflow": "e2e.yml",
      "events": ["workflow_dispatch", "push"],
      "jobs": ["e2e-full-suite"],
      "artifact": "e2e-full-suite-tree",
      "os": "Linux"
    },
    "native-locks.yml/native": {
      "workflow": "test.yml",
      "events": ["workflow_dispatch", "push"],
      "jobs": [
        "full-suite",
        "native-locks / linux-x64-glibc / Bun 1.4.4",
        "native-locks / linux-arm64-glibc / Bun 1.4.4",
        "native-locks / darwin-arm64 / Bun 1.4.4",
        "native-locks / darwin-x64 / Bun 1.4.4",
        "native-locks / win32-x64 / Bun 1.4.4",
        "native-locks / win32-arm64 / Bun 1.4.4"
      ],
      "artifact": "full-suite-tree"
    },
    "macos-validation.yml/macos-26": {
      "workflow": "macos-validation.yml",
      "events": ["workflow_dispatch"],
      "jobs": ["macOS 26 validation"],
      "artifact": "macos-26-tree",
      "os": "macOS"
    }
  },
  "remote_gate_runs": {
    "profiles": ["test", "e2e"],
    "inventory": "bash scripts/pregate-remote-gate.sh --list"
  },
  "ship_lanes_from": {
    "bun run test": {
      "profiles": ["test"],
      "inventory": "GBRAIN_PREGATE_GATE_CMD='bun run ci:ubicloud' bash scripts/pregate-remote-gate.sh --list --lanes unit,serial"
    },
    "bun run test:serial": {
      "profiles": ["test"],
      "inventory": "GBRAIN_PREGATE_GATE_CMD='bun run ci:ubicloud' bash scripts/pregate-remote-gate.sh --list --lanes serial"
    },
    "bun run test:slow": {
      "profiles": ["test"],
      "inventory": "GBRAIN_PREGATE_GATE_CMD='bun run ci:ubicloud' bash scripts/pregate-remote-gate.sh --list --lanes slow"
    },
    "bun run test:e2e": {
      "profiles": ["test", "e2e"],
      "inventory": "GBRAIN_PREGATE_GATE_CMD='bun run ci:ubicloud' bash scripts/pregate-remote-gate.sh --list --lanes e2e"
    }
  },
  "allowlist": [
    {
      "finding": "pii.phone.e164",
      "paths": [
        "scripts/*-weights.metadata.json"
      ],
      "reason": "shard-weight metadata records GitHub Actions run ids and commit counts, never phone numbers"
    },
    {
      "finding": "env.kv",
      "paths": [
        ".github/workflows/*.yml"
      ],
      "pattern": "pglite-snapshot-(?:default-)?\\$\\{\\{ runner\\.os \\}\\}-\\$\\{\\{ hashFiles\\('(?:src|test|scripts)(?:/[a-z*][a-z*_-]*(?:\\.[a-z]+)?)+'(?:, '(?:src|test|scripts)(?:/[a-z*][a-z*_-]*(?:\\.[a-z]+)?)+')*\\) \\}\\}$",
      "reason": "GitHub Actions PGLite snapshot cache keys: the whole value is pglite-snapshot-[default-]${{ runner.os }}-${{ hashFiles(<args>) }} and every argument is a lowercase path or glob under src/, test/ or scripts/; an argument with digits, capitals or a ./ prefix is not covered and stays flagged"
    },
    {
      "finding": "env.kv",
      "paths": [
        "src/core/operation-loaders.generated.ts"
      ],
      "pattern": "\\[load_[a-z0-9_]+, \"(?:[a-z][A-Za-z]*Operations|[a-z]+(?:_[a-z]+)+)\"\\],?$",
      "reason": "generated operation-loader table: each value is a loader identifier and an operations export name, never a credential; an operation named like a secret (reveal_secret) trips the key-name heuristic"
    },
    {
      "finding": "env.kv",
      "paths": [
        "rust/crates/gbrain-store/src/link_queries/link_temporal.rs"
      ],
      "pattern": "^&RelationshipKey,$",
      "reason": "a Rust type annotation, `key: &RelationshipKey,` (three places): a type, never a credential value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "rust/crates/gbrain-store/src/persistence/effect_worker.rs"
      ],
      "pattern": "^Option<&str>,$",
      "reason": "a Rust type annotation, `token: Option<&str>,`: a type, never a credential value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "rust/crates/gbrain-store/src/occ_kv.rs"
      ],
      "pattern": "^Mutex<HashMap<Vec<u8>, u64>>,$",
      "reason": "a Rust type annotation, `by_key: Mutex<HashMap<Vec<u8>, u64>>,`: a type, never a credential value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "rust/crates/gbrain-store/src/write_attribution.rs"
      ],
      "pattern": "^Option<PrivacyPolicy>,$",
      "reason": "a Rust type annotation, `exclude_private: Option<PrivacyPolicy>,`: a type, never a credential value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "rust/crates/gbrain-store/src/cli_reads/reads.rs"
      ],
      "pattern": "^:Char\\(c\\) => \\{$",
      "reason": "a match arm, `Token::Char(c) => {`, in a tokenizer: an enum pattern, never a credential value"
    }
  ]
}
